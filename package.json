{
  "name": "app-pantry",
  "productName": "AppPantry",
  "version": "1.0.0",
  "description": "A local-first Windows app downloader, installer and manager",
  "main": "src/main.js",
  "author": "Mar08Meow",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/patch-nsis.mjs && electron-builder --win",
    "dist:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.apppantry.app",
    "productName": "AppPantry",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AppPantry-${version}-${ext}"
    },
    "portable": {
      "artifactName": "AppPantry-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AppPantry",
      "artifactName": "AppPantry-${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
